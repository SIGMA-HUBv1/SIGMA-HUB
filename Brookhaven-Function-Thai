RunService.RenderStepped:Connect(function()
    pcall(function()
        if isPlayerESPEnabled then
            local myChar = LocalPlayer.Character
            local myHRP = myChar and myChar:FindFirstChild("HumanoidRootPart")

            for _, plr in ipairs(Players:GetPlayers()) do
                if plr ~= LocalPlayer and plr.Character and plr.Character:FindFirstChild("Head") then
                    local head = plr.Character.Head
                    local espGui = head:FindFirstChild("SigmaESP")

                    if not espGui then
                        espGui = Instance.new("BillboardGui")
                        espGui.Name = "SigmaESP"
                        espGui.AlwaysOnTop = true
                        espGui.Size = UDim2.new(0, 200, 0, 50)
                        espGui.StudsOffset = Vector3.new(0, 2.5, 0)
                        espGui.Parent = head

                        local nameLabel = Instance.new("TextLabel")
                        nameLabel.Name = "NameLabel"
                        nameLabel.Size = UDim2.new(1, 0, 0.5, 0)
                        nameLabel.Position = UDim2.new(0, 0, 0, 0)
                        nameLabel.BackgroundTransparency = 1
                        nameLabel.Text = plr.DisplayName or plr.Name
                        nameLabel.TextColor3 = Color3.fromRGB(0, 255, 100)
                        nameLabel.TextSize = 18
                        nameLabel.Font = Enum.Font.SourceSansBold
                        nameLabel.TextStrokeTransparency = 0.2
                        nameLabel.Parent = espGui

                        local distLabel = Instance.new("TextLabel")
                        distLabel.Name = "DistLabel"
                        distLabel.Size = UDim2.new(1, 0, 0.4, 0)
                        distLabel.Position = UDim2.new(0, 0, 0.5, 0)
                        distLabel.BackgroundTransparency = 1
                        distLabel.Text = ""
                        distLabel.TextColor3 = Color3.fromRGB(255, 255, 255)
                        distLabel.TextSize = 13
                        distLabel.Font = Enum.Font.SourceSans
                        distLabel.TextStrokeTransparency = 0.3
                        distLabel.Parent = espGui
                    end

                    local nameLabel = espGui:FindFirstChild("NameLabel")
                    local distLabel = espGui:FindFirstChild("DistLabel")

                    if nameLabel then
                        if isRainbowEnabled then
                            nameLabel.TextColor3 = Color3.fromHSV((tick() % 3) / 3, 1, 1)
                        else
                            nameLabel.TextColor3 = Color3.fromRGB(0, 255, 100)
                        end
                    end

                    if distLabel then
                        if isDistanceESPEnabled and myHRP and plr.Character:FindFirstChild("HumanoidRootPart") then
                            local dist = math.floor((myHRP.Position - plr.Character.HumanoidRootPart.Position).Magnitude)
                            distLabel.Text = "[" .. tostring(dist) .. " Studs]"
                            distLabel.Visible = true
                        else
                            distLabel.Visible = false
                        end
                    end
                end
            end
        end

        if isRainbowEnabled and not isPlayerESPEnabled then
            local character = LocalPlayer.Character
            if character and character:FindFirstChild("Head") then
                for _, v in ipairs(character.Head:GetChildren()) do
                    if v:IsA("BillboardGui") and v.Name ~= "SigmaESP" then
                        for _, label in ipairs(v:GetDescendants()) do
                            if label:IsA("TextLabel") then
                                label.TextColor3 = Color3.fromHSV((tick() % 3) / 3, 1, 1)
                            end
                        end
                    end
                end
            end
        end
    end)
end)

